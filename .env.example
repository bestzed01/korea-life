# KOREA-LIFE environment configuration
# Copy this file to ".env" and fill in your values. Never commit your real .env.

# Your Anthropic API key. Leave blank to run the app in FALLBACK (offline demo) mode.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for AI answers.
# Defaults to a current Sonnet model if unset.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: override where the SQLite database file is stored.
# Defaults to korea_life.db inside the project folder.
KOREA_LIFE_DB=
